# SERVER ONLY: Netlify Functions. Never prefix this variable with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/epi_central?sslmode=require

# Server-only OAuth settings. GOOGLE_CLIENT_ID should match VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
MAGNA_EMAILS=authorized1@example.com,authorized2@example.com

# Public client setting (exposed in browser; identifier only, not a secret).
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
