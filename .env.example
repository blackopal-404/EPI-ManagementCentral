# Browser-visible OAuth client ID (identifier only; not a secret)
VITE_GOOGLE_CLIENT_ID=

# SERVER ONLY — configure these in Netlify Environment Variables too.
# Do not prefix either variable with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/epi_central?sslmode=require
GOOGLE_CLIENT_ID=
MAGNA_EMAILS=authorized1@example.com,authorized2@example.com
